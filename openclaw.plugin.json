{
  "id": "openclaw-mesh",
  "name": "OpenClaw Mesh",
  "description": "Tailscale tailnet 内多 gateway 互联，agent 跨节点发消息",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["mesh_peers", "mesh_send"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sharedSecret": { "type": "string" },
      "meshToken": { "type": "string" },
      "port": { "type": "integer", "default": 18789 },
      "allowAgents": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Agent IDs that remote peers are allowed to message. Defaults to [\"main\"] if not set."
      },
      "discovery": {
        "type": "object",
        "properties": {
          "interval": { "type": "string", "default": "60s" },
          "probe": { "type": "boolean", "default": true }
        }
      },
      "peers": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "token": { "type": "string" }
          },
          "required": ["url", "token"]
        }
      }
    }
  }
}
