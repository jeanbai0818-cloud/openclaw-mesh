{
  "name": "openclaw-mesh",
  "version": "2026.5.14-3",
  "description": "Tailscale-based multi-gateway mesh communication for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "deploy": "openclaw plugins install .",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "package.json"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.0"
  },
  "devDependencies": {
    "openclaw": "2026.5.7",
    "typescript": "^5.9.3",
    "typebox": "^1.1.37",
    "@types/node": "^22"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.0",
      "minGatewayVersion": "2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.5.7",
      "pluginSdkVersion": "2026.5.7"
    },
    "prerequisites": {
      "binaries": ["tailscale", "openclaw"],
      "envVars": ["MESH_SECRET", "MESH_GATEWAY_TOKEN"]
    }
  }
}
